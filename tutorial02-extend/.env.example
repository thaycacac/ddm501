# Copy to .env and adjust ports if they clash on your machine:
#   cp .env.example .env
#
# MLflow UI — 5001 avoids clash with Tutorial 02 (5000) and macOS AirPlay
# 15432, not 5432: a Postgres installed on the host usually owns 5432, and
# 127.0.0.1:5432 would then reach it instead of the container.
POSTGRES_PORT=15432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5001

MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
MLFLOW_S3_IGNORE_TLS=true
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
MLFLOW_S3_BUCKET=mlflow
