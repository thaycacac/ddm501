digraph goals {
    graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.18, ranksep=0.5, newrank=true, pad=0.15];
    node  [fontname="Helvetica", fontsize=10.5, shape=box, style="rounded,filled", penwidth=1.2, width=1.9, margin="0.08,0.06"];
    edge  [color="#546e7a", arrowsize=0.7];

    subgraph cluster_b {
        label=<<b>BUSINESS GOALS</b> (Head of Retention, CFO)>; style="rounded,filled"; fillcolor="#fff8ee"; color="#b26a00";
        node [fillcolor="#fff4e5", color="#b26a00"];
        B1 [label=<<b>B1</b> Effective churn<br/>24.0% → ≤ 23.3%>];
        B2 [label=<<b>B2</b> Campaign ROI<br/>0.20 → ≥ 0.50>];
        B3 [label=<<b>B3</b> Complaints /<br/>opt-outs not up>];
    }
    subgraph cluster_s {
        label=<<b>SYSTEM GOALS</b> (MLOps / Platform)>; style="rounded,filled"; fillcolor="#f1f8f1"; color="#2e7d32";
        node [fillcolor="#e8f5e9", color="#2e7d32"];
        S1 [label=<<b>S1</b> Weekly list for<br/>100% of base<br/>by Mon 06:00>];
        S2 [label=<<b>S2</b> API p95 ≤ 200 ms,<br/>availability ≥ 99.5%>];
        S3 [label=<<b>S3</b> Drift found ≤ 7 d,<br/>retrain ≤ 2 d>];
        S4 [label=<<b>S4</b> Every score<br/>traceable: version<br/>+ reasons>];
    }
    subgraph cluster_m {
        label=<<b>MODEL GOALS</b> (Data Science)>; style="rounded,filled"; fillcolor="#f3f7fc"; color="#2f5d8a";
        node [fillcolor="#eef4fb", color="#2f5d8a"];
        M1 [label=<<b>M1</b> Recall@top-20%<br/>≥ 0.50>];
        M2 [label=<<b>M2</b> ROC-AUC ≥ 0.84<br/>PR-AUC ≥ 0.64>];
        M3 [label=<<b>M3</b> Calibrated<br/>Brier ≤ 0.15>];
        M4 [label=<<b>M4</b> Gender recall<br/>gap ≤ 0.05>];
    }
    B1 -> S1; B1 -> S3; B2 -> S1; B2 -> S4; B3 -> S4;
    S1 -> M1; S1 -> M2; S2 -> M2; S3 -> M2; S4 -> M3; S4 -> M4;
    {rank=same; B1; B2; B3;}
    {rank=same; S1; S2; S3; S4;}
    {rank=same; M1; M2; M3; M4;}
}
