# Copy thành .env trước khi chạy:   cp .env.example .env
# (.env bị .gitignore chặn — mỗi máy tự có bản của mình; .env.example thì commit)
#
# ---- Người đọc 1: docker compose -------------------------------------------
# Thay vào ${...} trong docker-compose.yml. Đổi port ở đây nếu máy bạn bị trùng.
POSTGRES_PORT=25432
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MLFLOW_PORT=5001

# ---- Người đọc 2: script Python trên máy bạn (load_dotenv trong connect.py) --
# Phải KHỚP với port ở trên — .env không tự ghép giúp bạn.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:29000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
