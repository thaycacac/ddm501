# Copy to .env and adjust. The Makefile loads .env automatically.
# Any config key: TELCO__<SECTION>__<KEY>=<value>  (see configs/config.yaml)

# Tracking backend (default: sqlite file in the project root)
# TELCO__MLFLOW__TRACKING_URI=http://localhost:5000
# TELCO__MLFLOW__EXPERIMENT_NAME=telco-churn-training

# Reproducibility
TELCO__PROJECT__SEED=42

# Optional: alternate config file
# TELCO_CONFIG=configs/config.yaml

# Airflow integration (used by dags/telco_churn_training_dag.py)
# TELCO_PROJECT_DIR=/opt/telco-churn
# TELCO_PYTHON=/opt/telco-churn/.venv/bin/python
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

LOG_LEVEL=INFO
MLFLOW_DISABLE_AGENT_HINT=1
